# Build-time PIN for the Admin Settings panel (default 1234 when unset).
# Not a security boundary: anything in a static bundle can be read. See README.
NEXT_PUBLIC_ADMIN_PIN=1234

# Public address the QR code links to (the deployed app). Leave empty to use the current origin.
NEXT_PUBLIC_PUBLIC_URL=

# Analytics (optional). Google Tag Manager container and/or a direct GA4 measurement ID.
# The deployed build uses the elektromarla.com container GTM-K785GZH.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
